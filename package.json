{
  "name": "nibfin-e2e",
  "private": true,
  "type": "module",
  "description": "Proposal-anchored release gate for Nibfin",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm test",
    "e2e": "node src/cli.ts",
    "gate": "node src/gate/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "eslint": "^10.15.0",
    "playwright-core": "1.65.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
